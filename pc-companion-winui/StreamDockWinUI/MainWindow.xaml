<Window x:Class="StreamDockWinUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:StreamDockWinUI.ViewModels"
        Title="Stream Dock Pro - Desktop GUI Editor" Height="750" Width="1160"
        Icon="pack://application:,,,/app_icon.ico"
        WindowStartupLocation="CenterScreen"
        Background="#11111B">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Border Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header / Selected Client Selector Bar -->
            <Border Grid.Row="0" Background="#181825" CornerRadius="10" Padding="15" Margin="0,0,0,15">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Stream Dock Pro" FontSize="20" FontWeight="Bold" Foreground="#89B4FA" VerticalAlignment="Center"/>
                        <Border Background="#212234" CornerRadius="6" Padding="8,4" Margin="14,0,0,0" BorderThickness="1" BorderBrush="#313244">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📡 IP Local: " Foreground="#A6ADC8" FontSize="11" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding LocalIpDisplay}" Foreground="#00E676" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                <Button Command="{Binding CopyLocalIpCommand}" Content="📋 Copiar" ToolTip="Copiar dirección IP para conectar desde la App Android"
                                        Background="#313244" Foreground="#CDD6F4" BorderThickness="0" FontSize="10" Padding="6,2" Margin="8,0,0,0" Cursor="Hand"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <CheckBox IsChecked="{Binding IsAutoProfileSwitchEnabled}"
                                  Content="🔄 Auto-Perfil por Ventana"
                                  Foreground="#A6E3A1"
                                  FontWeight="SemiBold"
                                  VerticalAlignment="Center"
                                  Margin="0,0,14,0"
                                  ToolTip="Cambia automáticamente la página en tu teléfono según el programa o juego abierto en primer plano"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock Text="Dispositivo:" Foreground="#A6ADC8" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
                            <ComboBox ItemsSource="{Binding ConnectedClients}"
                                      SelectedItem="{Binding SelectedClient}"
                                      Width="230"
                                      Height="34"
                                      Background="#313244"
                                      Foreground="#CDD6F4"
                                      BorderThickness="1"
                                      BorderBrush="#45475A"
                                      VerticalContentAlignment="Center"
                                      Padding="6,2">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📱 " FontSize="14" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" Foreground="#89B4FA" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Uuid, StringFormat=' ({0})'}" Foreground="#A6ADC8" FontSize="11" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Command="{Binding RefreshClientListCommand}" Content="🔄" ToolTip="Actualizar Lista de Dispositivos" Background="#45475A" Foreground="White" BorderThickness="0" Padding="8,4" Margin="6,0,0,0"/>
                        </StackPanel>
                        <Button Click="MinimizeToTray_Click" Content="🗕 Bandeja" ToolTip="Ocultar en la bandeja del sistema (el servidor seguirá activo)" Background="#313244" Foreground="#89B4FA" FontWeight="SemiBold" BorderThickness="0" Padding="10,6" Cursor="Hand"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Main Workspace Editor Panel -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="340"/>
                </Grid.ColumnDefinitions>

                <!-- Sidebar Perfiles -->
                <Border Grid.Column="0" Background="#181825" CornerRadius="10" Padding="15" Margin="0,0,12,0">
                    <DockPanel>
                        <TextBlock Text="PERFILES POR CONTEXTO" FontWeight="Bold" Foreground="#A6ADC8" DockPanel.Dock="Top" Margin="0,0,0,12"/>

                        <!-- Botón Crear Nuevo Perfil -->
                        <Border DockPanel.Dock="Bottom" Background="#89B4FA" CornerRadius="8" Margin="0,10,0,0">
                            <Button Content="+ Crear Perfil" Command="{Binding CreateProfileCommand}"
                                    Background="Transparent" Foreground="#11111B" FontWeight="Bold"
                                    BorderThickness="0" Padding="10,8" Cursor="Hand"/>
                        </Border>

                        <!-- Panel para Editar / Renombrar / Eliminar el Perfil Seleccionado -->
                        <Border DockPanel.Dock="Bottom" Background="#212234" CornerRadius="8" Padding="10" Margin="0,10,0,0" BorderThickness="1" BorderBrush="#313244">
                            <StackPanel>
                                <TextBlock Text="EDITAR PERFIL ACTIVO" FontWeight="Bold" Foreground="#F9E2AF" FontSize="10" Margin="0,0,0,6"/>
                                <TextBlock Text="Nombre del Perfil:" Foreground="#A6ADC8" FontSize="11" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding EditingProfileName, UpdateSourceTrigger=PropertyChanged}"
                                         Background="#313244" Foreground="White" BorderThickness="0" Padding="7,6" Margin="0,0,0,8">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Return" Command="{Binding SaveProfileNameCommand}"/>
                                    </TextBox.InputBindings>
                                </TextBox>

                                <TextBlock Text="Auto-Activar con App (.exe):" Foreground="#A6ADC8" FontSize="10" Margin="0,0,0,4"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Text="{Binding EditingProfileAutoProcess, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Ejemplo: obs64.exe, Spotify.exe, chrome.exe"
                                             Background="#313244" Foreground="#A6E3A1" FontSize="11" BorderThickness="0" Padding="6,5"/>
                                    <Border Grid.Column="1" Background="#45475A" CornerRadius="4" Margin="4,0,0,0">
                                        <Button Content="📁" Command="{Binding BrowseProfileProcessCommand}"
                                                ToolTip="Seleccionar programa (.exe) para activar este perfil automáticamente"
                                                Background="Transparent" Foreground="White" BorderThickness="0" Padding="7,4" Cursor="Hand"/>
                                    </Border>
                                </Grid>

                                <UniformGrid Columns="2">
                                    <Border Background="#A6E3A1" CornerRadius="6" Margin="0,0,3,0">
                                        <Button Content="💾 Guardar" Command="{Binding SaveProfileNameCommand}"
                                                ToolTip="Guardar nombre y programa asociado al perfil"
                                                Background="Transparent" Foreground="#11111B" FontWeight="Bold" FontSize="11"
                                                BorderThickness="0" Padding="6,6" Cursor="Hand"/>
                                    </Border>
                                    <Border Background="#F38BA8" CornerRadius="6" Margin="3,0,0,0">
                                        <Button Content="🗑️ Borrar" Command="{Binding DeleteProfileCommand}"
                                                ToolTip="Eliminar este perfil y todos sus botones"
                                                Background="Transparent" Foreground="#11111B" FontWeight="Bold" FontSize="11"
                                                BorderThickness="0" Padding="6,6" Cursor="Hand"/>
                                    </Border>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <!-- Lista de Perfiles -->
                        <ListBox Background="Transparent" BorderThickness="0" Foreground="#CDD6F4"
                                 HorizontalContentAlignment="Stretch"
                                 ItemsSource="{Binding Profiles}"
                                 SelectedItem="{Binding SelectedProfile}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="2" LastChildFill="True">
                                        <Button DockPanel.Dock="Right"
                                                Content="🗑️"
                                                ToolTip="Eliminar este perfil y sus botones"
                                                Command="{Binding DataContext.DeleteProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Background="Transparent" Foreground="#F38BA8" BorderThickness="0"
                                                Padding="6,2" Margin="4,0,0,0" Cursor="Hand"/>
                                        <TextBlock Text="{Binding Name}" Padding="6" VerticalAlignment="Center"
                                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- Center Grid Canvas (4x5 Dynamic Grid + Espacio Dedicado de Barras de Volumen del Perfil) -->
                <Border Grid.Column="1" Background="#181825" CornerRadius="10" Padding="20" Margin="0,0,12,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <DockPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,15">
                            <TextBlock Text="CUADRÍCULA TÁCTIL DEL PERFIL (4x5)" FontWeight="Bold" Foreground="#A6ADC8" VerticalAlignment="Center"/>
                            <TextBlock Text="💡 Arrastra botones para reordenarlos o agrega Barras de Volumen al Perfil" Foreground="#6C7086" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </DockPanel>
                        
                        <!-- Reactive 4x5 Button Grid -->
                        <ItemsControl Grid.Row="1" Grid.Column="0" ItemsSource="{Binding GridButtons}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="4" Columns="5"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="4" BorderThickness="2" CornerRadius="12"
                                            AllowDrop="True" Drop="Button_Drop" PreviewDragOver="Button_PreviewDragOver">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{Binding BackgroundColor}"/>
                                                <Setter Property="BorderBrush" Value="#313244"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="BorderBrush" Value="#F9E2AF"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsMoving}" Value="True">
                                                        <Setter Property="BorderBrush" Value="#A6E3A1"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Button Command="{Binding DataContext.SelectButtonCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                PreviewMouseLeftButtonDown="Button_PreviewMouseLeftButtonDown"
                                                PreviewMouseMove="Button_PreviewMouseMove"
                                                PreviewMouseLeftButtonUp="Button_PreviewMouseLeftButtonUp"
                                                Background="Transparent" BorderThickness="0" Cursor="Hand">
                                            <Border Padding="6">
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <!-- Native Extracted Icon Rendering -->
                                                    <Image Source="{Binding IconImage}" Width="54" Height="54" Margin="0,0,0,4"
                                                           RenderOptions.BitmapScalingMode="HighQuality"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <!-- Button Label -->
                                                    <TextBlock Text="{Binding Label}" Foreground="White" FontWeight="Bold"
                                                               FontSize="11" TextWrapping="Wrap" TextAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </Button>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- ESPACIO DEDICADO DE BARRAS DE VOLUMEN DENTRO DEL PERFIL -->
                        <Border Grid.Row="1" Grid.Column="1" Background="#13141F" CornerRadius="12" Padding="10" Margin="12,4,0,4"
                                BorderThickness="1.5" BorderBrush="#313244">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="🎚️ VOLUMEN" FontWeight="ExtraBold" Foreground="#89B4FA"
                                           FontSize="10" HorizontalAlignment="Center" Margin="0,0,0,8"/>

                                <!-- Botones de activación rápida cuando aún no hay barras activas en este perfil -->
                                <StackPanel Width="94" VerticalAlignment="Center">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasAnyProfileVolumeBar}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="Agrega barras deslizantes verticales a este perfil:"
                                               Foreground="#A6ADC8" FontSize="9.5" TextWrapping="Wrap"
                                               TextAlignment="Center" Margin="0,0,0,10"/>
                                    <Border Background="#2A2044" CornerRadius="8" Padding="6,8" Margin="0,0,0,8"
                                            BorderThickness="1.5" BorderBrush="#CBA6F7">
                                        <Button Command="{Binding TogglePcVolumeBarInProfileCommand}"
                                                Background="Transparent" BorderThickness="0" Cursor="Hand">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="🔊 + Barra PC" FontWeight="Bold" Foreground="#CBA6F7" FontSize="10.5" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Volumen Maestro" Foreground="#A6ADC8" FontSize="8.5" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Border>
                                    <Border Background="#113022" CornerRadius="8" Padding="6,8"
                                            BorderThickness="1.5" BorderBrush="#1DB954">
                                        <Button Command="{Binding ToggleSpotifyVolumeBarInProfileCommand}"
                                                Background="Transparent" BorderThickness="0" Cursor="Hand">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="🟢 + Spotify" FontWeight="Bold" Foreground="#1DB954" FontSize="10.5" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Volumen Exclusivo" Foreground="#A6ADC8" FontSize="8.5" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Border>
                                </StackPanel>

                                <!-- Botones compactos en la parte inferior para activar la segunda barra cuando solo 1 está activa -->
                                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                    <Border Background="#2A2044" CornerRadius="6" Padding="6,4" Margin="0,2"
                                            BorderThickness="1" BorderBrush="#CBA6F7">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding HasAnyProfileVolumeBar}" Value="True"/>
                                                            <Condition Binding="{Binding HasPcVolumeBarInProfile}" Value="False"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Button Content="🔊 + Barra PC" Command="{Binding TogglePcVolumeBarInProfileCommand}"
                                                Background="Transparent" Foreground="#CBA6F7" FontWeight="Bold" FontSize="9.5"
                                                BorderThickness="0" Cursor="Hand"/>
                                    </Border>
                                    <Border Background="#113022" CornerRadius="6" Padding="6,4" Margin="0,2"
                                            BorderThickness="1" BorderBrush="#1DB954">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding HasAnyProfileVolumeBar}" Value="True"/>
                                                            <Condition Binding="{Binding HasSpotifyVolumeBarInProfile}" Value="False"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Button Content="🟢 + Barra Spotify" Command="{Binding ToggleSpotifyVolumeBarInProfileCommand}"
                                                Background="Transparent" Foreground="#1DB954" FontWeight="Bold" FontSize="9.5"
                                                BorderThickness="0" Cursor="Hand"/>
                                    </Border>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <!-- Barra Vertical de Volumen Maestro PC -->
                                    <Border Background="#1E1B2E" CornerRadius="10" Padding="8,8" Margin="3,0"
                                            BorderThickness="1.5" BorderBrush="#CBA6F7" Width="64">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasPcVolumeBarInProfile}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <DockPanel Grid.Row="0" Margin="0,0,0,2">
                                                <TextBlock Text="🔊 PC" FontWeight="Bold" Foreground="#CBA6F7" FontSize="10" VerticalAlignment="Center"/>
                                                <Button Content="✕" Command="{Binding RemovePcVolumeBarFromProfileCommand}"
                                                        ToolTip="Quitar barra de volumen PC de este perfil"
                                                        Background="Transparent" Foreground="#6C7086" BorderThickness="0"
                                                        FontSize="9" Padding="2,0" HorizontalAlignment="Right" Cursor="Hand"/>
                                            </DockPanel>

                                            <TextBlock Grid.Row="1" Text="{Binding PcVolumeLevel, StringFormat='{}{0}%'}"
                                                       Foreground="White" FontWeight="ExtraBold" FontSize="12"
                                                       HorizontalAlignment="Center" Margin="0,2,0,8"/>

                                            <Slider Grid.Row="2" Orientation="Vertical" Minimum="0" Maximum="100"
                                                    Value="{Binding PcVolumeLevel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                                    IsMoveToPointEnabled="True" Cursor="Hand"
                                                    ToolTip="Desliza de arriba a abajo para subir o bajar el volumen maestro de la PC"/>

                                            <Button Grid.Row="3" Content="🔇" Command="{Binding MutePcFromBarCommand}"
                                                    ToolTip="Silenciar / Activar Audio Maestro de PC"
                                                    Background="#313244" Foreground="#F38BA8" BorderThickness="0"
                                                    Padding="6,4" Margin="0,8,0,0" Cursor="Hand"/>
                                        </Grid>
                                    </Border>

                                    <!-- Barra Vertical de Volumen Exclusivo Spotify -->
                                    <Border Background="#11241B" CornerRadius="10" Padding="8,8" Margin="3,0"
                                            BorderThickness="1.5" BorderBrush="#1DB954" Width="64">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasSpotifyVolumeBarInProfile}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <DockPanel Grid.Row="0" Margin="0,0,0,2">
                                                <TextBlock Text="🟢 SPO" FontWeight="Bold" Foreground="#1DB954" FontSize="10" VerticalAlignment="Center"/>
                                                <Button Content="✕" Command="{Binding RemoveSpotifyVolumeBarFromProfileCommand}"
                                                        ToolTip="Quitar barra de volumen de Spotify de este perfil"
                                                        Background="Transparent" Foreground="#6C7086" BorderThickness="0"
                                                        FontSize="9" Padding="2,0" HorizontalAlignment="Right" Cursor="Hand"/>
                                            </DockPanel>

                                            <TextBlock Grid.Row="1" Text="{Binding SpotifyVolumeLevel, StringFormat='{}{0}%'}"
                                                       Foreground="White" FontWeight="ExtraBold" FontSize="12"
                                                       HorizontalAlignment="Center" Margin="0,2,0,8"/>

                                            <Slider Grid.Row="2" Orientation="Vertical" Minimum="0" Maximum="100"
                                                    Value="{Binding SpotifyVolumeLevel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                                    IsMoveToPointEnabled="True" Cursor="Hand"
                                                    ToolTip="Desliza de arriba a abajo para subir o bajar el volumen exclusivo de Spotify"/>

                                            <Button Grid.Row="3" Content="🔇" Command="{Binding MuteSpotifyFromBarCommand}"
                                                    ToolTip="Silenciar / Activar solo Spotify"
                                                    Background="#1B3829" Foreground="#1DB954" BorderThickness="0"
                                                    Padding="6,4" Margin="0,8,0,0" Cursor="Hand"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Right Action Configuration Panel (3-Zone Stream Deck Layout) -->
                <Border Grid.Column="2" Background="#181825" CornerRadius="10" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- ZONA 1: CABECERA COMPACTA (Vista Previa + Etiqueta + Paleta de Colores en 1 Clic) -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="CONFIGURAR BOTÓN" FontWeight="Bold" Foreground="#89B4FA" FontSize="13" Margin="0,0,0,10"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="68"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Mini Preview Tile -->
                                <Border Grid.Column="0" Background="{Binding SelectedButton.BackgroundColor}" CornerRadius="10"
                                        Width="62" Height="62" HorizontalAlignment="Left" BorderThickness="1.5" BorderBrush="#45475A">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Image Source="{Binding SelectedButton.IconImage}" Width="34" Height="34"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <TextBlock Text="{Binding SelectedButton.Label}" Foreground="White" FontSize="8"
                                                   FontWeight="Bold" TextTrimming="CharacterEllipsis" MaxWidth="54"
                                                   HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Label + Quick Color Swatches -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0">
                                    <TextBlock Text="Etiqueta del Botón:" Foreground="#A6ADC8" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                    <TextBox Text="{Binding SelectedButton.Label, UpdateSourceTrigger=PropertyChanged}"
                                             Background="#313244" Foreground="White" BorderThickness="0" Padding="7,5" Margin="0,0,0,6"/>

                                    <!-- Paleta de Colores en 1 Clic -->
                                    <UniformGrid Columns="8" Height="20">
                                        <Button Command="{Binding SelectColorPresetCommand}" CommandParameter="#1E1E2E" Background="#1E1E2E" BorderBrush="#45475A" BorderThickness="1" Margin="1" Cursor="Hand" ToolTip="Oscuro"/>
                                        <Button Command="{Binding SelectColorPresetCommand}" CommandParameter="#2196F3" Background="#2196F3" BorderBrush="#45475A" BorderThickness="1" Margin="1" Cursor="Hand" ToolTip="Azul"/>
                                        <Button Command="{Binding SelectColorPresetCommand}" CommandParameter="#1DB954" Background="#1DB954" BorderBrush="#45475A" BorderThickness="1" Margin="1" Cursor="Hand" ToolTip="Verde Spotify"/>
                                        <Button Command="{Binding SelectColorPresetCommand}" CommandParameter="#9B59B6" Background="#9B59B6" BorderBrush="#45475A" BorderThickness="1" Margin="1" Cursor="Hand" ToolTip="Violeta"/>
                                        <Button Command="{Binding SelectColorPresetCommand}" CommandParameter="#E74C3C" Background="#E74C3C" BorderBrush="#45475A" BorderThickness="1" Margin="1" Cursor="Hand" ToolTip="Rojo"/>
                                        <Button Command="{Binding SelectColorPresetCommand}" CommandParameter="#E67E22" Background="#E67E22" BorderBrush="#45475A" BorderThickness="1" Margin="1" Cursor="Hand" ToolTip="Naranja"/>
                                        <Button Command="{Binding SelectColorPresetCommand}" CommandParameter="#4F46E5" Background="#4F46E5" BorderBrush="#45475A" BorderThickness="1" Margin="1" Cursor="Hand" ToolTip="Índigo"/>
                                        <Button Command="{Binding SelectColorPresetCommand}" CommandParameter="#34495E" Background="#34495E" BorderBrush="#45475A" BorderThickness="1" Margin="1" Cursor="Hand" ToolTip="Gris Acero"/>
                                    </UniformGrid>
                                </StackPanel>
                            </Grid>

                            <!-- SELECTOR DE 8 CATEGORÍAS CLARAS ("TIPO DE ACCIÓN") -->
                            <TextBlock Text="TIPO DE ACCIÓN:" Foreground="#A6ADC8" FontSize="10" FontWeight="Bold" Margin="0,0,0,5"/>
                            <UniformGrid Columns="2">
                                <!-- 1. Audio PC -->
                                <Border CornerRadius="6" Margin="2" BorderThickness="1.5">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#262738"/>
                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedCategoryTab}" Value="AUDIO_PC">
                                                    <Setter Property="Background" Value="#3B2E58"/>
                                                    <Setter Property="BorderBrush" Value="#CBA6F7"/>
