                                        </Border>
                                        <Border Background="#212234" CornerRadius="6" Margin="2" Padding="6" BorderThickness="1" BorderBrush="#313244">
                                            <Button Command="{Binding SelectActionPresetCommand}" CommandParameter="START_RECORD" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" Cursor="Hand">
                                                <StackPanel>
                                                    <TextBlock Text="🔴 Grabar OBS" FontWeight="Bold" Foreground="#F38BA8" FontSize="11"/>
                                                    <TextBlock Text="Iniciar / Detener grabación" Foreground="#A6ADC8" FontSize="9"/>
                                                </StackPanel>
                                            </Button>
                                        </Border>
                                        <Border Background="#212234" CornerRadius="6" Margin="2" Padding="6" BorderThickness="1" BorderBrush="#313244">
                                            <Button Command="{Binding SelectActionPresetCommand}" CommandParameter="TOGGLE_MUTE" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" Cursor="Hand">
                                                <StackPanel>
                                                    <TextBlock Text="🎙️ Mute Mic OBS" FontWeight="Bold" Foreground="#FAB387" FontSize="11"/>
                                                    <TextBlock Text="Silenciar micrófono OBS" Foreground="#A6ADC8" FontSize="9"/>
                                                </StackPanel>
                                            </Button>
                                        </Border>
                                        <Border Background="#212234" CornerRadius="6" Margin="2" Padding="6" BorderThickness="1" BorderBrush="#313244">
                                            <Button Command="{Binding SelectActionPresetCommand}" CommandParameter="Escena Principal" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" Cursor="Hand">
                                                <StackPanel>
                                                    <TextBlock Text="🎬 Escena Principal" FontWeight="Bold" Foreground="White" FontSize="11"/>
                                                    <TextBlock Text="Cambiar a escena" Foreground="#A6ADC8" FontSize="9"/>
                                                </StackPanel>
                                            </Button>
                                        </Border>
                                    </UniformGrid>

                                    <!-- Escenas Detectadas en OBS -->
                                    <StackPanel Margin="0,2,0,6">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasObsScenes}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="ESCENAS DETECTADAS EN OBS" FontWeight="Bold" Foreground="#89B4FA" FontSize="10" Margin="0,0,0,4"/>
                                        <ItemsControl ItemsSource="{Binding ObsScenes}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="2"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#212234" CornerRadius="6" Margin="2" Padding="6" BorderThickness="1" BorderBrush="#313244">
                                                        <Button Command="{Binding DataContext.SelectObsItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" Cursor="Hand">
                                                            <StackPanel>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding IconEmoji}" FontSize="11" Margin="0,0,4,0"/>
                                                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" Foreground="White" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding Subtitle}" Foreground="#A6ADC8" FontSize="9" TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <!-- Fuentes y Audio Detectados en OBS -->
                                    <StackPanel Margin="0,2,0,6">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasObsSources}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="FUENTES Y AUDIO DE OBS" FontWeight="Bold" Foreground="#A6E3A1" FontSize="10" Margin="0,0,0,4"/>
                                        <ItemsControl ItemsSource="{Binding ObsSources}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="1"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#212234" CornerRadius="6" Margin="2" Padding="6" BorderThickness="1" BorderBrush="#313244">
                                                        <Button Command="{Binding DataContext.SelectObsItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" Cursor="Hand">
                                                            <DockPanel>
                                                                <TextBlock Text="{Binding IconEmoji}" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                                <StackPanel VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" Foreground="White" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock Text="{Binding Subtitle}" Foreground="#A6ADC8" FontSize="9" TextTrimming="CharacterEllipsis"/>
                                                                </StackPanel>
                                                            </DockPanel>
                                                        </Button>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <!-- Configuración WebSocket OBS Compacta -->
                                    <Border Background="#212234" CornerRadius="8" Padding="8" Margin="0,4,0,4" BorderThickness="1" BorderBrush="#313244">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*"/>
                                                    <ColumnDefinition Width="1*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                                    <TextBlock Text="Host OBS:" Foreground="#A6ADC8" FontSize="10"/>
                                                    <TextBox Text="{Binding ObsHost, UpdateSourceTrigger=PropertyChanged}" Background="#313244" Foreground="White" BorderThickness="0" Padding="5,4" FontSize="11"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                                    <TextBlock Text="Puerto:" Foreground="#A6ADC8" FontSize="10"/>
                                                    <TextBox Text="{Binding ObsPort, UpdateSourceTrigger=PropertyChanged}" Background="#313244" Foreground="White" BorderThickness="0" Padding="5,4" FontSize="11"/>
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Text="Contraseña WebSocket OBS:" Foreground="#A6ADC8" FontSize="10"/>
                                            <TextBox Text="{Binding ObsPassword, UpdateSourceTrigger=PropertyChanged}" Background="#313244" Foreground="White" BorderThickness="0" Padding="5,4" FontSize="11" Margin="0,2,0,6"/>
                                            <Border Background="#89B4FA" CornerRadius="6">
                                                <Button Command="{Binding ScanObsWebSocketCommand}" Content="🔍 Escanear Escenas y Fuentes OBS" Background="Transparent" Foreground="#11111B" FontWeight="Bold" FontSize="11" BorderThickness="0" Padding="6" Cursor="Hand"/>
                                            </Border>
                                            <TextBlock Text="{Binding ObsScanStatus}" Foreground="#89B4FA" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- ==================== 6. ATAJOS DE TECLADO ==================== -->
                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedCategoryTab}" Value="KEYBOARD_HOTKEY">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>

                                    <TextBlock Text="GRABADOR Y ATAJOS RÁPIDOS DE TECLADO" FontWeight="Bold" Foreground="#F9E2AF" FontSize="10" Margin="0,0,0,6"/>
                                    <Border CornerRadius="8" Padding="10" Margin="0,0,0,8" BorderThickness="1.5">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#212234"/>
                                                <Setter Property="BorderBrush" Value="#F9E2AF"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRecordingHotkey}" Value="True">
                                                        <Setter Property="Background" Value="#4A1E2B"/>
                                                        <Setter Property="BorderBrush" Value="#F38BA8"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Button Command="{Binding ToggleHotkeyRecordingCommand}" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Center" Cursor="Hand">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock FontWeight="Bold" FontSize="12" HorizontalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="🔴 Grabar Teclas desde mi Teclado"/>
                                                            <Setter Property="Foreground" Value="#F9E2AF"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsRecordingHotkey}" Value="True">
                                                                    <Setter Property="Text" Value="⌨️ ¡Presiona tus teclas ahora! (ESC cancela)"/>
                                                                    <Setter Property="Foreground" Value="#F38BA8"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="Haz clic y pulsa cualquier combinación real" Foreground="#A6ADC8" FontSize="9.5" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Button>
                                    </Border>

                                    <UniformGrid Columns="2">
                                        <Border Background="#212234" CornerRadius="6" Margin="2" Padding="7" BorderThickness="1" BorderBrush="#313244">
                                            <Button Command="{Binding SelectActionPresetCommand}" CommandParameter="CTRL+SHIFT+M" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="🎙️ Mute Discord" FontWeight="Bold" Foreground="White" FontSize="11" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="Ctrl + Shift + M" Foreground="#A6ADC8" FontSize="9" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </Border>
                                        <Border Background="#212234" CornerRadius="6" Margin="2" Padding="7" BorderThickness="1" BorderBrush="#313244">
                                            <Button Command="{Binding SelectActionPresetCommand}" CommandParameter="WIN+SHIFT+S" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="✂️ Captura Pantalla" FontWeight="Bold" Foreground="White" FontSize="11" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="Win + Shift + S" Foreground="#A6ADC8" FontSize="9" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </Border>
                                        <Border Background="#212234" CornerRadius="6" Margin="2" Padding="7" BorderThickness="1" BorderBrush="#313244">
                                            <Button Command="{Binding SelectActionPresetCommand}" CommandParameter="CTRL+C" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="📋 Copiar" FontWeight="Bold" Foreground="White" FontSize="11" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="Ctrl + C" Foreground="#A6ADC8" FontSize="9" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </Border>
                                        <Border Background="#212234" CornerRadius="6" Margin="2" Padding="7" BorderThickness="1" BorderBrush="#313244">
                                            <Button Command="{Binding SelectActionPresetCommand}" CommandParameter="CTRL+V" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="📥 Pegar" FontWeight="Bold" Foreground="White" FontSize="11" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="Ctrl + V" Foreground="#A6ADC8" FontSize="9" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </Border>
                                        <Border Background="#212234" CornerRadius="6" Margin="2" Padding="7" BorderThickness="1" BorderBrush="#313244">
                                            <Button Command="{Binding SelectActionPresetCommand}" CommandParameter="ALT+TAB" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="🔄 Cambiar App" FontWeight="Bold" Foreground="White" FontSize="11" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="Alt + Tab" Foreground="#A6ADC8" FontSize="9" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </Border>
                                        <Border Background="#212234" CornerRadius="6" Margin="2" Padding="7" BorderThickness="1" BorderBrush="#313244">
                                            <Button Command="{Binding SelectActionPresetCommand}" CommandParameter="ALT+F4" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="❌ Cerrar (Alt+F4)" FontWeight="Bold" Foreground="#F38BA8" FontSize="11" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="Alt + F4" Foreground="#A6ADC8" FontSize="9" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </Border>
                                    </UniformGrid>
                                </StackPanel>

                                <!-- ==================== 7. IR A PÁGINA (NAVIGATE) ==================== -->
                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedCategoryTab}" Value="NAVIGATE">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>

                                    <TextBlock Text="SELECCIONA LA PÁGINA / PERFIL DE DESTINO" FontWeight="Bold" Foreground="#818CF8" FontSize="10" Margin="0,0,0,6"/>
                                    <ItemsControl ItemsSource="{Binding Profiles}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="2"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#212234" CornerRadius="8" Margin="3" Padding="8" BorderThickness="1.5" BorderBrush="#4F46E5">
                                                    <Button Command="{Binding DataContext.SelectNavigateProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Background="Transparent" BorderThickness="0" Cursor="Hand">
                                                        <StackPanel HorizontalAlignment="Center">
                                                            <TextBlock Text="📄" FontSize="18" HorizontalAlignment="Center"/>
                                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="White" FontSize="11" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                                            <TextBlock Text="Abrir esta página" Foreground="#A6ADC8" FontSize="9" HorizontalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- ==================== 8. SISTEMA PC ==================== -->
                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedCategoryTab}" Value="SYSTEM_COMMAND">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>

                                    <TextBlock Text="COMANDOS DE ENERGÍA Y SEGURIDAD DE WINDOWS" FontWeight="Bold" Foreground="#F38BA8" FontSize="10" Margin="0,0,0,6"/>
                                    <UniformGrid Columns="2">
                                        <Border Background="#212234" CornerRadius="8" Margin="3" Padding="10" BorderThickness="1.5" BorderBrush="#313244">
                                            <Button Command="{Binding SelectActionPresetCommand}" CommandParameter="LOCK_WORKSTATION" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="🔒" FontSize="20" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="Bloquear PC" FontWeight="Bold" Foreground="White" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                                    <TextBlock Text="Pantalla de bloqueo" Foreground="#A6ADC8" FontSize="9" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </Border>
                                        <Border Background="#212234" CornerRadius="8" Margin="3" Padding="10" BorderThickness="1.5" BorderBrush="#313244">
                                            <Button Command="{Binding SelectActionPresetCommand}" CommandParameter="SLEEP" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="🌙" FontSize="20" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="Suspender PC" FontWeight="Bold" Foreground="#CBA6F7" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                                    <TextBlock Text="Modo reposo" Foreground="#A6ADC8" FontSize="9" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </Border>
                                        <Border Background="#212234" CornerRadius="8" Margin="3" Padding="10" BorderThickness="1.5" BorderBrush="#313244">
                                            <Button Command="{Binding SelectActionPresetCommand}" CommandParameter="REBOOT" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="🔄" FontSize="20" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="Reiniciar PC" FontWeight="Bold" Foreground="#FAB387" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                                    <TextBlock Text="Reinicio del sistema" Foreground="#A6ADC8" FontSize="9" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </Border>
                                        <Border Background="#212234" CornerRadius="8" Margin="3" Padding="10" BorderThickness="1.5" BorderBrush="#313244">
                                            <Button Command="{Binding SelectActionPresetCommand}" CommandParameter="SHUTDOWN" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="🛑" FontSize="20" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="Apagar PC" FontWeight="Bold" Foreground="#F38BA8" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                                    <TextBlock Text="Apagado seguro" Foreground="#A6ADC8" FontSize="9" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </Border>
                                    </UniformGrid>
                                </StackPanel>

                                <!-- Valor / Parámetro actual (compacto) -->
                                <TextBlock Text="Comando / Ruta Asignada:" Foreground="#A6ADC8" FontSize="10" FontWeight="SemiBold" Margin="0,8,0,3"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding SelectedButton.ActionValue, UpdateSourceTrigger=PropertyChanged}"
                                             Background="#313244" Foreground="#CDD6F4" FontSize="11" BorderThickness="0" Padding="7,5"/>
                                    <Border Grid.Column="1" Background="#45475A" CornerRadius="4" Margin="4,0,0,0">
                                        <Button Content="📁" Command="{Binding BrowseFileCommand}" ToolTip="Examinar archivo .exe o .lnk"
                                                Background="Transparent" Foreground="White" BorderThickness="0" Padding="8,4" Cursor="Hand"/>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ZONA 3: BARRA INFERIOR FIJA (Siempre visible sin hacer scroll) -->
                        <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="#313244" Padding="0,10,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1.25*"/>
                                    <ColumnDefinition Width="0.85*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="#A6E3A1" CornerRadius="7" Margin="0,0,4,0">
                                    <Button Content="▶️ Probar"
                                            Command="{Binding ExecuteSelectedActionCommand}"
                                            ToolTip="Probar esta acción inmediatamente en la PC"
                                            Background="Transparent" Foreground="#11111B" FontWeight="Bold" FontSize="12"
                                            BorderThickness="0" Padding="6,9" Cursor="Hand"/>
                                </Border>

                                <Border Grid.Column="1" Background="#89B4FA" CornerRadius="7" Margin="2,0">
                                    <Button Content="💾 Guardar"
                                            Command="{Binding SaveButtonConfigurationCommand}"
                                            ToolTip="Guardar y sincronizar con el teléfono Android"
                                            Background="Transparent" Foreground="#11111B" FontWeight="Bold" FontSize="12"
                                            BorderThickness="0" Padding="6,9" Cursor="Hand"/>
                                </Border>

                                <Border Grid.Column="2" Background="#F38BA8" CornerRadius="7" Margin="4,0,0,0">
                                    <Button Content="🗑️ Borrar"
                                            Command="{Binding DeleteButtonConfigurationCommand}"
                                            ToolTip="Eliminar botón y compactar cuadrícula"
                                            Background="Transparent" Foreground="#11111B" FontWeight="Bold" FontSize="12"
                                            BorderThickness="0" Padding="6,9" Cursor="Hand"/>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- Bottom Status Bar -->
            <Border Grid.Row="2" Background="#181825" CornerRadius="6" Padding="10,6" Margin="0,10,0,0">
                <TextBlock Text="{Binding StatusMessage}" Foreground="#A6ADC8" FontSize="12"/>
            </Border>
        </Grid>
    </Border>
</Window>
