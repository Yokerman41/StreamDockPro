                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="1*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                <TextBlock Text="Host / IP:" Foreground="#A6ADC8" FontSize="11" Margin="0,0,0,2"/>
                                                <TextBox Text="{Binding ObsHost, UpdateSourceTrigger=PropertyChanged}" Background="#313244" Foreground="White" BorderThickness="0" Padding="6"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                <TextBlock Text="Puerto:" Foreground="#A6ADC8" FontSize="11" Margin="0,0,0,2"/>
                                                <TextBox Text="{Binding ObsPort, UpdateSourceTrigger=PropertyChanged}" Background="#313244" Foreground="White" BorderThickness="0" Padding="6"/>
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="Contraseña WebSocket (Opcional):" Foreground="#A6ADC8" FontSize="11" Margin="0,0,0,2"/>
                                        <TextBox Text="{Binding ObsPassword, UpdateSourceTrigger=PropertyChanged}" Background="#313244" Foreground="White" BorderThickness="0" Padding="6" Margin="0,0,0,10"/>

