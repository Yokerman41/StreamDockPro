                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <TextBlock Text="CONFIGURACIÓN WEBSOCKET DE OBS" FontWeight="Bold" Foreground="#F9E2AF" FontSize="11" Margin="0,0,0,8"/>
