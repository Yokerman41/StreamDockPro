<Window x:Class="StreamDockWinUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:StreamDockWinUI.ViewModels"
        Title="Stream Dock Pro - Desktop GUI Editor" Height="750" Width="1160"
        Icon="pack://application:,,,/app_icon.ico"
        WindowStartupLocation="CenterScreen"
        Background="#11111B">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Border Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header / Selected Client Selector Bar -->
            <Border Grid.Row="0" Background="#181825" CornerRadius="10" Padding="15" Margin="0,0,0,15">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Stream Dock Pro" FontSize="20" FontWeight="Bold" Foreground="#89B4FA" VerticalAlignment="Center"/>
                        <Border Background="#212234" CornerRadius="6" Padding="8,4" Margin="14,0,0,0" BorderThickness="1" BorderBrush="#313244">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📡 IP Local: " Foreground="#A6ADC8" FontSize="11" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding LocalIpDisplay}" Foreground="#00E676" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                <Button Command="{Binding CopyLocalIpCommand}" Content="📋 Copiar" ToolTip="Copiar dirección IP para conectar desde la App Android"
                                        Background="#313244" Foreground="#CDD6F4" BorderThickness="0" FontSize="10" Padding="6,2" Margin="8,0,0,0" Cursor="Hand"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <CheckBox IsChecked="{Binding IsAutoProfileSwitchEnabled}"
                                  Content="🔄 Auto-Perfil por Ventana"
                                  Foreground="#A6E3A1"
                                  FontWeight="SemiBold"
                                  VerticalAlignment="Center"
                                  Margin="0,0,14,0"
                                  ToolTip="Cambia automáticamente la página en tu teléfono según el programa o juego abierto en primer plano"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock Text="Dispositivo:" Foreground="#A6ADC8" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
                            <ComboBox ItemsSource="{Binding ConnectedClients}"
                                      SelectedItem="{Binding SelectedClient}"
                                      Width="230"
                                      Height="34"
                                      Background="#313244"
                                      Foreground="#CDD6F4"
                                      BorderThickness="1"
                                      BorderBrush="#45475A"
                                      VerticalContentAlignment="Center"
                                      Padding="6,2">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📱 " FontSize="14" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" Foreground="#89B4FA" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Uuid, StringFormat=' ({0})'}" Foreground="#A6ADC8" FontSize="11" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Command="{Binding RefreshClientListCommand}" Content="🔄" ToolTip="Actualizar Lista de Dispositivos" Background="#45475A" Foreground="White" BorderThickness="0" Padding="8,4" Margin="6,0,0,0"/>
                        </StackPanel>
                        <Button Click="MinimizeToTray_Click" Content="🗕 Bandeja" ToolTip="Ocultar en la bandeja del sistema (el servidor seguirá activo)" Background="#313244" Foreground="#89B4FA" FontWeight="SemiBold" BorderThickness="0" Padding="10,6" Cursor="Hand"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Main Workspace Editor Panel -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="340"/>
                </Grid.ColumnDefinitions>

                <!-- Sidebar Perfiles -->
                <Border Grid.Column="0" Background="#181825" CornerRadius="10" Padding="15" Margin="0,0,12,0">
                    <DockPanel>
                        <TextBlock Text="PERFILES POR CONTEXTO" FontWeight="Bold" Foreground="#A6ADC8" DockPanel.Dock="Top" Margin="0,0,0,12"/>

                        <!-- Botón Crear Nuevo Perfil -->
                        <Border DockPanel.Dock="Bottom" Background="#89B4FA" CornerRadius="8" Margin="0,10,0,0">
                            <Button Content="+ Crear Perfil" Command="{Binding CreateProfileCommand}"
                                    Background="Transparent" Foreground="#11111B" FontWeight="Bold"
                                    BorderThickness="0" Padding="10,8" Cursor="Hand"/>
                        </Border>

                        <!-- Panel para Editar / Renombrar / Eliminar el Perfil Seleccionado -->
                        <Border DockPanel.Dock="Bottom" Background="#212234" CornerRadius="8" Padding="10" Margin="0,10,0,0" BorderThickness="1" BorderBrush="#313244">
                            <StackPanel>
                                <TextBlock Text="EDITAR PERFIL ACTIVO" FontWeight="Bold" Foreground="#F9E2AF" FontSize="10" Margin="0,0,0,6"/>
                                <TextBlock Text="Nombre del Perfil:" Foreground="#A6ADC8" FontSize="11" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding EditingProfileName, UpdateSourceTrigger=PropertyChanged}"
                                         Background="#313244" Foreground="White" BorderThickness="0" Padding="7,6" Margin="0,0,0,8">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Return" Command="{Binding SaveProfileNameCommand}"/>
                                    </TextBox.InputBindings>
                                </TextBox>

                                <TextBlock Text="Auto-Activar con App (.exe):" Foreground="#A6ADC8" FontSize="10" Margin="0,0,0,4"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Text="{Binding EditingProfileAutoProcess, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Ejemplo: obs64.exe, Spotify.exe, chrome.exe"
                                             Background="#313244" Foreground="#A6E3A1" FontSize="11" BorderThickness="0" Padding="6,5"/>
                                    <Border Grid.Column="1" Background="#45475A" CornerRadius="4" Margin="4,0,0,0">
                                        <Button Content="📁" Command="{Binding BrowseProfileProcessCommand}"
                                                ToolTip="Seleccionar programa (.exe) para activar este perfil automáticamente"
                                                Background="Transparent" Foreground="White" BorderThickness="0" Padding="7,4" Cursor="Hand"/>
                                    </Border>
                                </Grid>

                                <UniformGrid Columns="2">
                                    <Border Background="#A6E3A1" CornerRadius="6" Margin="0,0,3,0">
                                        <Button Content="💾 Guardar" Command="{Binding SaveProfileNameCommand}"
                                                ToolTip="Guardar nombre y programa asociado al perfil"
                                                Background="Transparent" Foreground="#11111B" FontWeight="Bold" FontSize="11"
                                                BorderThickness="0" Padding="6,6" Cursor="Hand"/>
                                    </Border>
                                    <Border Background="#F38BA8" CornerRadius="6" Margin="3,0,0,0">
                                        <Button Content="🗑️ Borrar" Command="{Binding DeleteProfileCommand}"
                                                ToolTip="Eliminar este perfil y todos sus botones"
                                                Background="Transparent" Foreground="#11111B" FontWeight="Bold" FontSize="11"
                                                BorderThickness="0" Padding="6,6" Cursor="Hand"/>
                                    </Border>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <!-- Lista de Perfiles -->
                        <ListBox Background="Transparent" BorderThickness="0" Foreground="#CDD6F4"
                                 HorizontalContentAlignment="Stretch"
                                 ItemsSource="{Binding Profiles}"
                                 SelectedItem="{Binding SelectedProfile}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="2" LastChildFill="True">
                                        <Button DockPanel.Dock="Right"
                                                Content="🗑️"
                                                ToolTip="Eliminar este perfil y sus botones"
                                                Command="{Binding DataContext.DeleteProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Background="Transparent" Foreground="#F38BA8" BorderThickness="0"
                                                Padding="6,2" Margin="4,0,0,0" Cursor="Hand"/>
                                        <TextBlock Text="{Binding Name}" Padding="6" VerticalAlignment="Center"
                                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- Center Grid Canvas (4x5 Dynamic Grid with Drag & Drop & Icon Display) -->
                <Border Grid.Column="1" Background="#181825" CornerRadius="10" Padding="20" Margin="0,0,12,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <DockPanel Grid.Row="0" Margin="0,0,0,15">
                            <TextBlock Text="CUADRÍCULA TÁCTIL (4x5)" FontWeight="Bold" Foreground="#A6ADC8" VerticalAlignment="Center"/>
                            <TextBlock Text="💡 Arrastra botones para reordenarlos o suelta archivos .exe/.lnk" Foreground="#6C7086" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </DockPanel>
                        
                        <!-- Reactive 4x5 Button Grid -->
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding GridButtons}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="4" Columns="5"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="4" BorderThickness="2" CornerRadius="12"
                                            AllowDrop="True" Drop="Button_Drop" PreviewDragOver="Button_PreviewDragOver">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{Binding BackgroundColor}"/>
                                                <Setter Property="BorderBrush" Value="#313244"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="BorderBrush" Value="#F9E2AF"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsMoving}" Value="True">
                                                        <Setter Property="BorderBrush" Value="#A6E3A1"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Button Command="{Binding DataContext.SelectButtonCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                PreviewMouseLeftButtonDown="Button_PreviewMouseLeftButtonDown"
                                                PreviewMouseMove="Button_PreviewMouseMove"
                                                PreviewMouseLeftButtonUp="Button_PreviewMouseLeftButtonUp"
                                                Background="Transparent" BorderThickness="0" Cursor="Hand">
                                            <Border Padding="6">
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <!-- Native Extracted Icon Rendering -->
                                                    <Image Source="{Binding IconImage}" Width="54" Height="54" Margin="0,0,0,4"
                                                           RenderOptions.BitmapScalingMode="HighQuality"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <!-- Button Label -->
                                                    <TextBlock Text="{Binding Label}" Foreground="White" FontWeight="Bold"
                                                               FontSize="11" TextWrapping="Wrap" TextAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </Button>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <!-- Right Action Configuration Panel -->
                <Border Grid.Column="2" Background="#181825" CornerRadius="10" Padding="15">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="CONFIGURAR BOTÓN" FontWeight="Bold" Foreground="#89B4FA" FontSize="14" Margin="0,0,0,15"/>
                            
                            <!-- Icon Preview Card -->
                            <Border Background="#1E1E2E" CornerRadius="10" Padding="12" Margin="0,0,0,15" HorizontalAlignment="Center" Width="90" Height="90">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Image Source="{Binding SelectedButton.IconImage}" Width="44" Height="44"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <TextBlock Text="Vista Previa" Foreground="#A6ADC8" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Label Configuration -->
                            <TextBlock Text="Etiqueta del Botón:" Foreground="#CDD6F4" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding SelectedButton.Label, UpdateSourceTrigger=PropertyChanged}" 
                                     Background="#313244" Foreground="White" BorderThickness="0" Padding="8" Margin="0,0,0,15"/>

                            <!-- Action Type Category Selector Buttons -->
                            <TextBlock Text="Tipo de Acción:" Foreground="#CDD6F4" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <UniformGrid Columns="2" Margin="0,0,0,15">
                                <Border CornerRadius="6" Margin="2" BorderThickness="1.5">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#313244"/>
                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedButton.ActionType}" Value="MEDIA_CONTROL">
                                                    <Setter Property="Background" Value="#3B2E58"/>
                                                    <Setter Property="BorderBrush" Value="#CBA6F7"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Button Content="🎵 Multimedia" Command="{Binding SelectActionTypeCommand}" CommandParameter="MEDIA_CONTROL"
                                            Background="Transparent" Foreground="White" BorderThickness="0" Padding="6,8" FontWeight="SemiBold" Cursor="Hand"/>
                                </Border>
                                <Border CornerRadius="6" Margin="2" BorderThickness="1.5">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#313244"/>
                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedButton.ActionType}" Value="LAUNCH_APP">
                                                    <Setter Property="Background" Value="#1E3A5F"/>
                                                    <Setter Property="BorderBrush" Value="#89B4FA"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Button Content="🚀 Aplicación" Command="{Binding SelectActionTypeCommand}" CommandParameter="LAUNCH_APP"
                                            Background="Transparent" Foreground="White" BorderThickness="0" Padding="6,8" FontWeight="SemiBold" Cursor="Hand"/>
                                </Border>
                                <Border CornerRadius="6" Margin="2" BorderThickness="1.5">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#313244"/>
                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedButton.ActionType}" Value="KEYBOARD_HOTKEY">
                                                    <Setter Property="Background" Value="#2A3B4C"/>
                                                    <Setter Property="BorderBrush" Value="#F9E2AF"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Button Content="⌨️ Atajo Win32" Command="{Binding SelectActionTypeCommand}" CommandParameter="KEYBOARD_HOTKEY"
                                            Background="Transparent" Foreground="White" BorderThickness="0" Padding="6,8" FontWeight="SemiBold" Cursor="Hand"/>
                                </Border>
                                <Border CornerRadius="6" Margin="2" BorderThickness="1.5">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#313244"/>
                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedButton.ActionType}" Value="OBS_SCENE_SWITCH">
                                                    <Setter Property="Background" Value="#1B3B48"/>
                                                    <Setter Property="BorderBrush" Value="#89DCEB"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Button Content="🎥 OBS" Command="{Binding SelectActionTypeCommand}" CommandParameter="OBS_SCENE_SWITCH"
                                            Background="Transparent" Foreground="White" BorderThickness="0" Padding="6,8" FontWeight="SemiBold" Cursor="Hand"/>
                                </Border>
                                <Border CornerRadius="6" Margin="2" BorderThickness="1.5">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#313244"/>
                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedButton.ActionType}" Value="STREAMER_BOT_ACTION">
                                                    <Setter Property="Background" Value="#1E3B2E"/>
                                                    <Setter Property="BorderBrush" Value="#A6E3A1"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Button Content="🤖 Streamer.bot" Command="{Binding SelectActionTypeCommand}" CommandParameter="STREAMER_BOT_ACTION"
                                            Background="Transparent" Foreground="White" BorderThickness="0" Padding="6,8" FontWeight="SemiBold" Cursor="Hand"/>
                                </Border>
                                <Border CornerRadius="6" Margin="2" BorderThickness="1.5">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#313244"/>
                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedButton.ActionType}" Value="SYSTEM_COMMAND">
                                                    <Setter Property="Background" Value="#4A2533"/>
                                                    <Setter Property="BorderBrush" Value="#F38BA8"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Button Content="⚙️ Sistema" Command="{Binding SelectActionTypeCommand}" CommandParameter="SYSTEM_COMMAND"
                                            Background="Transparent" Foreground="White" BorderThickness="0" Padding="6,8" FontWeight="SemiBold" Cursor="Hand"/>
                                </Border>
                            </UniformGrid>

                            <!-- Sub-Menu Card Options for KEYBOARD_HOTKEY (Grabador Interactivo de Teclas) -->
                            <StackPanel Margin="0,5,0,15">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedButton.ActionType}" Value="KEYBOARD_HOTKEY">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <TextBlock Text="GRABADOR INTERACTIVO DE ATAJOS" FontWeight="Bold" Foreground="#F9E2AF" FontSize="11" Margin="0,0,0,8"/>
                                <Border CornerRadius="8" Padding="10" Margin="0,0,0,8" BorderThickness="1.5">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#212234"/>
                                            <Setter Property="BorderBrush" Value="#313244"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRecordingHotkey}" Value="True">
                                                    <Setter Property="Background" Value="#4A1E2B"/>
                                                    <Setter Property="BorderBrush" Value="#F38BA8"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Button Command="{Binding ToggleHotkeyRecordingCommand}" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Center" Cursor="Hand">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock FontWeight="Bold" FontSize="12" HorizontalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="🔴 Grabar Combinación de Teclas"/>
                                                        <Setter Property="Foreground" Value="#F9E2AF"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsRecordingHotkey}" Value="True">
                                                                <Setter Property="Text" Value="⌨️ ¡Presiona tus teclas ahora! (ESC cancela)"/>
                                                                <Setter Property="Foreground" Value="#F38BA8"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="Haz clic aquí y pulsa ej. Ctrl + Shift + M en tu teclado" Foreground="#A6ADC8" FontSize="10" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </Border>
                            </StackPanel>

                            <!-- Sub-Menu Card Options for MEDIA_CONTROL -->
                            <StackPanel Margin="0,5,0,15">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedButton.ActionType}" Value="MEDIA_CONTROL">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <TextBlock Text="TARJETAS MULTIMEDIA" FontWeight="Bold" Foreground="#F9E2AF" FontSize="11" Margin="0,0,0,8"/>
                                <UniformGrid Columns="1">
                                    <Border Background="#212234" CornerRadius="8" Margin="0,3" Padding="8" BorderThickness="1" BorderBrush="#313244">
                                        <Button Command="{Binding SelectActionPresetCommand}" CommandParameter="PLAY_PAUSE"
                                                Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" Cursor="Hand">
                                            <DockPanel>
                                                <TextBlock Text="⏯️" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Play / Pausa" FontWeight="Bold" Foreground="White"/>
                                                    <TextBlock Text="Reproducir o pausar audio / video" Foreground="#A6ADC8" FontSize="10"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Button>
                                    </Border>

                                    <Border Background="#212234" CornerRadius="8" Margin="0,3" Padding="8" BorderThickness="1" BorderBrush="#313244">
                                        <Button Command="{Binding SelectActionPresetCommand}" CommandParameter="VOLUME_MUTE"
                                                Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" Cursor="Hand">
                                            <DockPanel>
                                                <TextBlock Text="🔇" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Silenciar Audio" FontWeight="Bold" Foreground="#F38BA8"/>
                                                    <TextBlock Text="Mutea o desmutea el sonido de Windows" Foreground="#A6ADC8" FontSize="10"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Button>
                                    </Border>

                                    <Border Background="#212234" CornerRadius="8" Margin="0,3" Padding="8" BorderThickness="1" BorderBrush="#313244">
                                        <Button Command="{Binding SelectActionPresetCommand}" CommandParameter="VOLUME_UP"
                                                Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" Cursor="Hand">
                                            <DockPanel>
                                                <TextBlock Text="🔊" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Subir Volumen" FontWeight="Bold" Foreground="#A6E3A1"/>
                                                    <TextBlock Text="Aumenta el nivel de audio principal" Foreground="#A6ADC8" FontSize="10"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Button>
                                    </Border>

                                    <Border Background="#212234" CornerRadius="8" Margin="0,3" Padding="8" BorderThickness="1" BorderBrush="#313244">
                                        <Button Command="{Binding SelectActionPresetCommand}" CommandParameter="VOLUME_DOWN"
                                                Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" Cursor="Hand">
                                            <DockPanel>
                                                <TextBlock Text="🔉" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Bajar Volumen" FontWeight="Bold" Foreground="#FAB387"/>
                                                    <TextBlock Text="Disminuye el nivel de audio principal" Foreground="#A6ADC8" FontSize="10"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Button>
                                    </Border>

                                    <Border Background="#212234" CornerRadius="8" Margin="0,3" Padding="8" BorderThickness="1" BorderBrush="#313244">
                                        <Button Command="{Binding SelectActionPresetCommand}" CommandParameter="NEXT_TRACK"
                                                Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" Cursor="Hand">
                                            <DockPanel>
                                                <TextBlock Text="⏭️" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Pista Siguiente" FontWeight="Bold" Foreground="#89B4FA"/>
                                                    <TextBlock Text="Avanza a la siguiente canción" Foreground="#A6ADC8" FontSize="10"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Button>
                                    </Border>

                                    <Border Background="#212234" CornerRadius="8" Margin="0,3" Padding="8" BorderThickness="1" BorderBrush="#313244">
                                        <Button Command="{Binding SelectActionPresetCommand}" CommandParameter="PREV_TRACK"
                                                Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" Cursor="Hand">
                                            <DockPanel>
                                                <TextBlock Text="⏮️" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Pista Anterior" FontWeight="Bold" Foreground="#89B4FA"/>
