                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>

                                    <TextBlock Text="FUENTES Y ENTRADAS DETECTADAS EN OBS" FontWeight="Bold" Foreground="#A6E3A1" FontSize="11" Margin="0,0,0,6"/>
                                    <ItemsControl ItemsSource="{Binding ObsSources}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="1"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
