                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <TextBlock Text="🔍 " FontSize="13"/>
                                                    <TextBlock Text="Escanear Escenas y Fuentes OBS" FontWeight="Bold"/>
                                                </StackPanel>
                                            </Button>
                                        </Border>

                                        <!-- Scan Status Text -->
                                        <TextBlock Text="{Binding ObsScanStatus}" Foreground="#89B4FA" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- Escenas Detectadas en OBS -->
                                <StackPanel Margin="0,4,0,8">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasObsScenes}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>

                                    <TextBlock Text="ESCENAS DETECTADAS EN OBS" FontWeight="Bold" Foreground="#89B4FA" FontSize="11" Margin="0,0,0,6"/>
                                    <ItemsControl ItemsSource="{Binding ObsScenes}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="2"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#212234" CornerRadius="6" Margin="2" Padding="6" BorderThickness="1" BorderBrush="#313244">
                                                    <Button Command="{Binding DataContext.SelectObsItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" Cursor="Hand">
                                                        <StackPanel>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding IconEmoji}" FontSize="11" Margin="0,0,4,0"/>
                                                                <TextBlock Text="{Binding Title}" FontWeight="Bold" Foreground="White" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Subtitle}" Foreground="#A6ADC8" FontSize="9" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                    </Button>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

