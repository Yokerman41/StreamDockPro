                            </Border>

                            <!-- Delete / Clear Button -->
                            <Border Background="#F38BA8" CornerRadius="8">
                                <Button Content="🗑️ Eliminar Botón"
                                        Command="{Binding DeleteButtonConfigurationCommand}"
                                        Background="Transparent" Foreground="#11111B" FontWeight="Bold" FontSize="14"
                                        BorderThickness="0" Padding="12,10"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- Bottom Status Bar -->
            <Border Grid.Row="2" Background="#181825" CornerRadius="6" Padding="10,6" Margin="0,10,0,0">
                <TextBlock Text="{Binding StatusMessage}" Foreground="#A6ADC8" FontSize="12"/>
            </Border>
        </Grid>
    </Border>
</Window>
